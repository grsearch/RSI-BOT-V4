# ============ Solana 配置 ============
# 你的钱包私钥 (base58 格式) - 必填
WALLET_PRIVATE_KEY=

# Helius RPC (Business Plan)
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-fra.helius-rpc.com

# Birdeye API (Premium Plus)
BIRDEYE_API_KEY=
BIRDEYE_WSS_URL=wss://public-api.birdeye.so/socket/solana

# Jupiter (Developer Plan)
JUPITER_API_KEY=
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL=https://api.jup.ag/swap/v1/swap

# Jito (防夹)
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000

# ============ 交易参数 ============
TRADE_AMOUNT_SOL=2
DEFAULT_SLIPPAGE_BPS=300
BUY_RETRY_MAX_SLIPPAGE_BPS=500
SELL_RETRY_MAX_SLIPPAGE_BPS=1000
MAX_RETRY=3

# ============ 策略参数 ============
KLINE_INTERVAL_SEC=300
RSI_PERIOD=7
RSI_BUY_THRESHOLD=35
RSI_SELL_HIGH=80
RSI_SELL_CROSS_DOWN=70
EMA_PERIOD=99
EMA_SLOPE_LOOKBACK=5

TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=-50
TRAILING_ACTIVATE_PCT=30
TRAILING_DROP_PCT=-20
SELL_COOLDOWN_SEC=1800

# ============ 监控池 ============
MAX_TOKENS=100
MIN_FDV_USD=30000
MIN_LP_USD=10000

# ============ 服务 ============
PORT=3001
LOG_LEVEL=info
DB_PATH=./data/bot.db

# ============ 实盘开关 ============
LIVE_TRADING=true
