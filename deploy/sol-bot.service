[Unit]
Description=SOL RSI+Volume Trading Bot Backend (V4)
Documentation=https://github.com/your-org/sol-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solbot
Group=solbot
WorkingDirectory=/opt/sol-bot/backend

# 环境
Environment=NODE_ENV=production
EnvironmentFile=/opt/sol-bot/backend/.env

# 启动命令
ExecStart=/usr/bin/node src/index.js

# 优雅退出 - 给 SIGTERM 后等待 15 秒（足够交易队列清空 + WAL落盘）
KillSignal=SIGTERM
TimeoutStopSec=15
SendSIGKILL=yes

# 自动重启 - 异常退出 5 秒后重启，最多 5 次/分钟（避免雪崩）
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# 资源限制（2C4G 服务器适用）
LimitNOFILE=65535
MemoryMax=2G

# 日志（输出到 systemd journal）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sol-bot

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sol-bot/backend/data /opt/sol-bot/backend/logs
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
